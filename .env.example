# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# API Setu (Aadhaar Verification)
# Get credentials from: https://setu.co/
API_SETU_CLIENT_ID=your_api_setu_client_id
API_SETU_CLIENT_SECRET=your_api_setu_client_secret
API_SETU_BASE_URL=https://dg-sandbox.setu.co  # Use https://dg.setu.co for production

# Razorpay (Payment Integration)
# Get credentials from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Security
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AADHAAR_ENCRYPTION_KEY=your_encryption_key

# Google Gemini Vision (ID Card Authenticity Check)
# Get free API key from: https://aistudio.google.com → "Get API Key"
GEMINI_API_KEY=your_gemini_api_key_here


# Verification Settings
FUZZY_MATCH_THRESHOLD=85  # Minimum similarity score (0-100)
VERIFICATION_AMOUNT=100  # Amount in paise (₹1 = 100 paise)
